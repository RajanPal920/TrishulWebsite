# Trishul Metals & Alloys Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (MySQL Primary, SQLite Fallback)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trishul_db
DATABASE_PATH=./server/data/trishul.db

# Production Public URL (Used in customer emails, never localhost)
APP_URL=https://trishul-website.vercel.app

# Real Email Delivery Configuration
# Option A: Resend REST API (Recommended for Vercel deployment)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM="Trishul Metals & Alloys" <notifications@trishulmetal.com>

# Option B: Standard SMTP (Hostinger / Gmail / Google Workspace / cPanel / AWS SES)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@trishulmetal.com
SMTP_PASS=your_actual_mailbox_password
SMTP_SECURE=true
EMAIL_FROM="Trishul Metals & Alloys" <notifications@trishulmetal.com>
